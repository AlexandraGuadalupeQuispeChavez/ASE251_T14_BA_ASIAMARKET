# ============================================
# ARCHIVO DE EJEMPLO - NO USAR DIRECTAMENTE
# ============================================
# Copia este archivo como .env y reemplaza con tus credenciales reales

# ============================================
# CONFIGURACIÓN DE MONGODB ATLAS
# ============================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster-asiamarket.xxxxx.mongodb.net/?appName=cluster-asiamarket
MONGO_DATABASE=asiamarket_analytics

# Ejemplo de cómo se vería con datos reales:
# MONGO_URI=mongodb+srv://miusuario:mipassword@cluster-asiamarket.abc123.mongodb.net/?appName=cluster-asiamarket
# MONGO_DATABASE=asiamarket_analytics

# ============================================
# CONFIGURACIÓN DE SQL SERVER (FUTURO)
# ============================================
# SQL_SERVER=tu-servidor.database.windows.net
# SQL_DATABASE=tu-base-de-datos
# SQL_USERNAME=tu-usuario
# SQL_PASSWORD=tu-password
# SQL_DRIVER={ODBC Driver 17 for SQL Server}

# ============================================
# CÓMO OBTENER TUS CREDENCIALES:
# ============================================
# 1. Ve a https://www.mongodb.com/cloud/atlas/register
# 2. Crea una cuenta gratuita
# 3. Crea un nuevo proyecto: ASE251_T20_BA_ASIAMARKET
# 4. Crea un cluster gratuito (M0) llamado: cluster-asiamarket
# 5. En la ventana de seguridad, copia el username y password
# 6. Descarga el archivo .env que te proporciona MongoDB
# 7. Copia la URI de conexión desde "Drivers" -> "Python"
# 8. Pega tus credenciales en el archivo .env (NO en este archivo .example)
